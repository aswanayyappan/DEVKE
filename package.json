{
  "name": "universal-dev-knowledge-engine-workspace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Universal Developer Documentation and Knowledge Engine Monorepo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "typescript": "^5.4.5"
  }
}
